#!/usr/bin/env ruby
# frozen_string_literal: true

# 坐标转换命令行工具
#
#   coordconver wgs2gcj 121.468738 31.247138    # 单点坐标系转换
#   coordconver gcj2bd  121.473279 31.245217
#   coordconver dms     38.65777 104.08296      # 十进制度 -> 度分秒
#   coordconver dec     "38°39′27.97″" "104°4′58.66″"   # 度分秒 -> 十进制度
#   coordconver dist    116.397 39.909 121.473 31.230   # 两点球面距离(米)
#   cat points.txt | coordconver wgs2gcj        # 批量: 每行 "lng,lat" 或 "lng lat"
#   coordconver geo --gaode "北京方恒国际中心A座"   # 地址 -> 坐标 (需 API key)
#   coordconver regeo --baidu 116.322987 39.983424 # 坐标 -> 地址 (需 API key)

require "optparse"
require "json"

lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) if File.exist?(File.join(lib, "coordconver.rb"))
require "coordconver"

CONVERSION_ALIASES = {
  "wgs" => "wgs", "wgs84" => "wgs",
  "gcj" => "gcj", "gcj02" => "gcj",
  "bd" => "bd", "bd09" => "bd"
}.freeze

METHOD_MAP = {
  %w[wgs gcj] => "wgs_gcj", %w[gcj wgs] => "gcj_wgs",
  %w[wgs bd] => "wgs_bd", %w[bd wgs] => "bd_wgs",
  %w[gcj bd] => "gcj_bd", %w[bd gcj] => "bd_gcj"
}.freeze

def usage_and_exit(message = nil)
  warn message if message
  warn "用法: coordconver <命令> [参数] (--help 查看完整帮助)"
  exit 1
end

def parse_conversion(name)
  match = name.to_s.match(%r{\A(wgs84|wgs|gcj02|gcj|bd09|bd)\s*(?:2|to|->|=>|_)\s*(wgs84|wgs|gcj02|gcj|bd09|bd)\z}i)
  usage_and_exit("无法识别的转换名称: #{name}") unless match

  from = CONVERSION_ALIASES[match[1].downcase]
  to = CONVERSION_ALIASES[match[2].downcase]
  usage_and_exit("源坐标系与目标坐标系相同") if from == to

  METHOD_MAP[[from, to]]
end

def parse_coords(args)
  coords = args.flat_map { |a| a.to_s.split(/[,\s]+/).reject(&:empty?).map(&:to_f) }
  usage_and_exit("坐标参数不足, 需要 <lng> <lat>") if coords.size < 2
  coords
end

options = { round: 6, json: false }
parser = OptionParser.new do |opts|
  opts.banner = "coordconver #{Coordconver::VERSION} — 坐标系/度分秒转换命令行工具"

  opts.separator ""
  opts.separator "坐标系转换 (WGS-84 地球 / GCJ-02 火星·高德 / BD-09 百度):"
  opts.separator "  coordconver <转换名> <lng> <lat>   转换名如 wgs2gcj, gcj2bd, wgs84togcj02"

  opts.separator ""
  opts.separator "其他命令:"
  opts.separator "  dms  <lng> <lat>                    十进制度转度分秒"
  opts.separator "  dec  <度分秒> <度分秒>              度分秒转十进制度"
  opts.separator "  dist <lng1> <lat1> <lng2> <lat2>    两点球面距离(米)"
  opts.separator "  geo  <地址> --baidu|--gaode         地址转坐标(需 API key)"
  opts.separator "  regeo <lng> <lat> --baidu|--gaode   坐标转地址(需 API key)"
  opts.separator ""
  opts.separator "批量模式: 未给坐标参数时从 stdin 读取, 每行一条 \"lng,lat\" 或 \"lng lat\""

  opts.separator ""
  opts.separator "选项:"
  opts.on("--baidu", "geo/regeo 使用百度地图 API") { options[:provider] = "baidu" }
  opts.on("--gaode", "geo/regeo 使用高德地图 API (默认)") { options[:provider] = "gaode" }
  opts.on("-j", "--json", "以 JSON 数组输出") { options[:json] = true }
  opts.on("-r", "--round N", Integer, "小数位数, 默认 6") { |v| options[:round] = v }
  opts.on("-h", "--help", "显示帮助") { puts opts; exit 0 }
  opts.on("-v", "--version", "显示版本") { puts "coordconver #{Coordconver::VERSION}"; exit 0 }
end
parser.parse!(ARGV)

def configure_from_env(provider)
  Coordconver.configure do |c|
    if provider == "baidu" && ENV["COORDCONVER_BAIDU_AK"]
      c.baidu_map_aks = ENV["COORDCONVER_BAIDU_AK"].split(",").map(&:strip)
    elsif provider == "gaode" && ENV["COORDCONVER_GAODE_KEY"]
      c.gaode_map_keys = ENV["COORDCONVER_GAODE_KEY"].split(",").map(&:strip)
    end
  end
end

def emit(result, options)
  rounded = result.map { |v| v.is_a?(Numeric) ? v.round(options[:round]) : v }
  options[:json] ? puts(JSON.generate(rounded)) : puts(rounded.join(","))
end

command = ARGV.shift
usage_and_exit if command.nil?

begin
  case command.downcase
  when "dms"
    usage_and_exit("dms 需要 <lng> <lat> 两个参数") if ARGV.size < 2
    emit(Coordconver.degree(Float(ARGV[0]), Float(ARGV[1])), options)
  when "dec"
    usage_and_exit("dec 需要 <度分秒> <度分秒> 两个参数") if ARGV.size < 2
    emit(Coordconver.undegree(ARGV[0], ARGV[1]), options)
  when "dist"
    usage_and_exit("dist 需要 <lng1> <lat1> <lng2> <lat2> 四个参数") if ARGV.size < 4
    puts Coordconver.distance(Float(ARGV[0]), Float(ARGV[1]), Float(ARGV[2]), Float(ARGV[3]))
  when "geo"
    provider = options[:provider] || "gaode"
    usage_and_exit("geo 需要 <地址> 参数, 并指定 --baidu 或 --gaode") if ARGV.empty?
    configure_from_env(provider)
    location = provider == "baidu" ? Coordconver::Baidu.geo_location(ARGV[0]) : Coordconver::Gaode.geo_location(ARGV[0])
    if location
      emit(location, options)
    else
      warn "解析失败: #{ARGV[0].inspect}"
      exit 2
    end
  when "regeo"
    provider = options[:provider] || "gaode"
    usage_and_exit("regeo 需要 <lng> <lat> 参数, 并指定 --baidu 或 --gaode") if ARGV.size < 2
    configure_from_env(provider)
    address = provider == "baidu" ? Coordconver::Baidu.regeo_address(Float(ARGV[0]), Float(ARGV[1])) : Coordconver::Gaode.regeo_address(Float(ARGV[0]), Float(ARGV[1]))
    if address
      puts address
    else
      warn "解析失败: #{ARGV[0]},#{ARGV[1]}"
      exit 2
    end
  else
    method = parse_conversion(command)
    if ARGV.empty?
      usage_and_exit("需要 <lng> <lat> 参数, 或通过 stdin 管道输入批量坐标") if $stdin.tty?

      $stdin.each_line do |line|
        coords = line.split(/[,\s]+/).reject(&:empty?).map(&:to_f)
        next if coords.size < 2

        emit(Coordconver.public_send(method, coords[0], coords[1]), options)
      end
    else
      coords = parse_coords(ARGV)
      emit(Coordconver.public_send(method, coords[0], coords[1]), options)
    end
  end
rescue Coordconver::Error, ArgumentError, TypeError => e
  warn "错误: #{e.message}"
  exit 2
end
